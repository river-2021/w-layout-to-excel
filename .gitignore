# ==================================
.DS_Store
Thumbs.db
.idea/
.vscode/

# ==================================
# Python 相关 (针对 _venv 和 .venv)
# ==================================
# 虚拟环境
_venv/
.venv/
venv/
env/
ENV/

# 编译缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 打包/分发
build/
dist/
*.egg-info/
.eggs/

# 测试/覆盖率
.pytest_cache/
.coverage
htmlcov/

# ==================================
# Node.js 相关 (针对 package.json)
# ==================================
# 依赖包（注意：这也会忽略 .opencode/node_modules）
node_modules/

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==================================
# 环境变量与机密
# ==================================
.env
.env.local
.env.*.local
*.pem

# ==================================
# 项目特定：临时/生成文件
# ==================================
# 如果你的脚本会在根目录或测试目录生成 Excel 结果，且你不想提交它们，
# 可以取消下面两行的注释：
# *.xlsx
# output/

# 忽略测试过程中生成的临时文件
test/tmp/
*.tmp
*.log